{
  "name": "bc-threads",
  "description": "A minimal, -betterC-compatible fork-join thread pool for D",
  "targetType": "staticLibrary",
  "toolchainRequirements": {
    "dmd": "no"
  },
  "sourcePaths": [
    "source"
  ],
  "importPaths": [
    "source"
  ],
  "dependencies": {
    "libfp": {
      "repository": "git+https://github.com/doir-lang/libfp.git",
      "version": "735c83d753e7690652294b2bd71e8608f459029c"
    }
  },
  "dflags-ldc": [
    "-betterC",
    "-checkaction=C"
  ],
  "configurations": [
    {
      "name": "library",
      "targetType": "staticLibrary"
    },
    {
      "name": "unittest",
      "targetType": "executable",
      "mainSourceFile": "tests/runner.d",
      "sourcePaths": [
        "tests"
      ],
      "importPaths": [
        "tests"
      ]
    }
  ]
}
